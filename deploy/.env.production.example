# Template for /opt/fleet/.env on the VPS. Copy, fill, chmod 600.
# This file is created ONCE by hand and never touched by deploys — the deploy
# bundle deliberately excludes .env, so secrets live in exactly two places:
# this file (runtime) and GitHub Actions secrets (pipeline).
#
# Generate secrets:  openssl rand -hex 32   (JWT)
#                    openssl rand -hex 24   (passwords)

# ---- deployment ----------------------------------------------------------
# The single public hostname. It serves the API at / and public objects at
# /fleet/ — see deploy/nginx/go-logistics.conf.
API_DOMAIN=go-logistics.jesuslab135.com
# Rewritten by deploy.sh on every deploy — leave the placeholder on first boot.
API_IMAGE=ghcr.io/jesuslab135/go-logistics:latest

# ---- infrastructure secrets ---------------------------------------------
POSTGRES_PASSWORD=<openssl rand -hex 24>
MINIO_ROOT_USER=fleet-admin
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>

# ---- application (mirrors .env.example PROD block) -----------------------
APP_ENV=production
HTTP_ADDR=:8080
# Serves the interactive docs at /swagger/index.html. Defaults to off under
# APP_ENV=production because it publishes the entire API surface; set it only
# if you want the docs reachable by anyone who knows the URL.
SWAGGER_ENABLED=true
# The frontend's exact origin(s), comma-separated. NOT "*" in production, and
# NOT this backend's own origin — a browser never sends that, so allowlisting
# only it means no Access-Control-Allow-Origin header comes back and every
# browser client is blocked. Add http://localhost:5173 while browser-testing
# against this deployment.
CORS_ORIGINS=https://app.example.com,http://localhost:5173

JWT_SECRET=<openssl rand -hex 32>
JWT_ISSUER=fleet
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

STORAGE_BACKEND=minio
STORAGE_MINIO_BUCKET=fleet
STORAGE_MINIO_REGION=us-east-1
STORAGE_MINIO_PUBLIC=true

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
UPLOAD_THUMBNAIL_MAX_DIM=320

PAGE_DEFAULT_SIZE=25
PAGE_MAX_SIZE=100
DASHBOARD_UPCOMING_DAYS=30

# DATABASE_URL and the STORAGE_MINIO_ENDPOINT/ACCESS_KEY/SECRET_KEY/USE_SSL/
# PUBLIC_URL group are intentionally absent: docker-compose.yml derives them
# from the values above, and its environment: block overrides env_file anyway.
