# Copy to .env for local development. cmd/api and cmd/cli load .env automatically.
#
# This file holds THREE environment blocks: DEV, QA, PROD.
# Keep exactly ONE block uncommented at a time — comment out the others.
# (Later env vars with the same name override earlier ones, so an accidentally
#  uncommented PROD line below DEV would win — keep the unused blocks commented.)

# ==========================================================================
# DEV (local) — ACTIVE
# ==========================================================================
APP_ENV=development
HTTP_ADDR=:8080
CORS_ORIGINS=*

DATABASE_URL=postgres://postgres:postgres@localhost:5433/fleet?sslmode=disable

JWT_SECRET=local-dev-secret
JWT_ISSUER=fleet
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h

STORAGE_BACKEND=minio
STORAGE_MINIO_ENDPOINT=localhost:9000
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_BUCKET=fleet
STORAGE_MINIO_REGION=us-east-1
STORAGE_MINIO_USE_SSL=false
STORAGE_MINIO_PUBLIC=true
# STORAGE_MINIO_PUBLIC_URL=            # CDN/base URL override; MUST end with the bucket name
# STORAGE_MINIO_PUBLIC_URL_IS_BUCKET_ROOT=false   # true only if a CDN maps that URL to the bucket root

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
# Longest side of a generated thumbnail, in pixels. Every image type above gets
# one (JPEG, PNG, GIF, WebP); PDFs do not.
UPLOAD_THUMBNAIL_MAX_DIM=320

PAGE_DEFAULT_SIZE=25
PAGE_MAX_SIZE=100

# How far ahead GET /api/v1/dashboard/stats counts a service reminder as upcoming.
DASHBOARD_UPCOMING_DAYS=30

# To use local disk instead of MinIO in DEV, set STORAGE_BACKEND=local and:
# STORAGE_LOCAL_ROOT=./uploads
# STORAGE_BASE_URL=/media

# ==========================================================================
# QA — commented out
# ==========================================================================
# APP_ENV=qa
# HTTP_ADDR=:8080
# CORS_ORIGINS=https://qa.your-domain.com
#
# DATABASE_URL=postgres://<user>:<pass>@<qa-db-host>:5432/fleet?sslmode=require
#
# JWT_SECRET=<qa-jwt-secret>
# JWT_ISSUER=fleet
# JWT_ACCESS_TTL=1h
# JWT_REFRESH_TTL=168h
#
# STORAGE_BACKEND=minio
# STORAGE_MINIO_ENDPOINT=<qa-minio-host>:9000
# STORAGE_MINIO_ACCESS_KEY=<qa-access-key>
# STORAGE_MINIO_SECRET_KEY=<qa-secret-key>
# STORAGE_MINIO_BUCKET=fleet-qa
# STORAGE_MINIO_REGION=us-east-1
# STORAGE_MINIO_USE_SSL=true
# STORAGE_MINIO_PUBLIC=true
# STORAGE_MINIO_PUBLIC_URL=https://qa-cdn.your-domain.com/fleet-qa
#
# PAGE_DEFAULT_SIZE=25
# PAGE_MAX_SIZE=100

# ==========================================================================
# PROD — commented out
# ==========================================================================
# APP_ENV=production
# HTTP_ADDR=:8080
# CORS_ORIGINS=https://app.your-domain.com
# Swagger UI defaults to ON everywhere except APP_ENV=production, where serving
# it would publish the whole API surface. Set it explicitly to override either way.
# SWAGGER_ENABLED=true
#
# DATABASE_URL=postgres://<user>:<pass>@<prod-db-host>:5432/fleet?sslmode=require
#
# JWT_SECRET=<prod-jwt-secret-from-secret-manager>
# JWT_ISSUER=fleet
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h
#
# STORAGE_BACKEND=minio
# STORAGE_MINIO_ENDPOINT=<prod-s3-or-minio-host>
# STORAGE_MINIO_ACCESS_KEY=<prod-access-key>
# STORAGE_MINIO_SECRET_KEY=<prod-secret-key>
# STORAGE_MINIO_BUCKET=fleet-prod
# STORAGE_MINIO_REGION=us-east-1
# STORAGE_MINIO_USE_SSL=true
# STORAGE_MINIO_PUBLIC=true
# STORAGE_MINIO_PUBLIC_URL=https://cdn.your-domain.com/fleet-prod
#
# PAGE_DEFAULT_SIZE=25
# PAGE_MAX_SIZE=100
