# Copy to .env for local development. cmd/api loads .env automatically.

# Server
APP_ENV=development
HTTP_ADDR=:8080
CORS_ORIGINS=*

# Database (pgx DSN)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleet?sslmode=disable

# JWT
JWT_SECRET=change-me-in-production
JWT_ISSUER=fleet
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h

# Storage
STORAGE_LOCAL_ROOT=./uploads
STORAGE_BASE_URL=/media

# Pagination
PAGE_DEFAULT_SIZE=25
PAGE_MAX_SIZE=100
